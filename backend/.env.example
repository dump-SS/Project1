# 复制为 .env 后填入真实值，.env 已在仓库根 .gitignore 内
# 说明：pydantic-settings 会自动加载同目录下的 .env

# --- 服务 ---
APP_NAME=EpochX API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- 数据库 ---
# SQLite 文件路径；相对路径（./data.db）会在 config.py 里自动锚定到 backend/ 目录，
# 无需关心进程工作目录（cwd）不一致导致的「unable to open database file」
DATABASE_URL=sqlite:///./data.db

# --- 鉴权（占位，等队长通知再加 JWT 逻辑）---
# 现阶段用 mock bearer 即可，下个 PR 接入 JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AI 接入（PRD 6.4：供应商抽象层，避免与单一厂商强耦合）---
# 设为 "mock" 时走规则模板兜底，ai_suggestion.py 任何时候都有可用输出
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 真实 LLM 接入示例（OpenAI 兼容协议，Bearer 鉴权）：
# 1) aiping.cn / 类似聚合服务
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://aiping.cn/api/v1
# LLM_MODEL=Step-3.5-Flash
# 2) OpenAI 官方
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 注意：通义千问 DashScope 用 X-DashScope-API-Key、Azure OpenAI URL 路径不同，
# 接入时需在 llm_provider.py 的 OpenAICompatibleProvider 调整 headers；当前未实现

# --- embedding（板块二 · 2026-08-25 决策：第三方 API 可适当出域，预留自有服务器接入位）---
# KB_EMBED_MODE 取值：off=默认，走 name_fuzzy 关键词降级；
#   api=第三方 OpenAI 兼容 /v1/embeddings（Bearer 鉴权）；local=本地 bge-small-zh-v1.5
# 示例（OpenAI 兼容服务，如硅基流动/智谱等）：
# KB_EMBED_MODE=api
# EMBED_API_KEY=sk-...
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3
# 日后接入自有服务器模型：只需把 EMBED_BASE_URL/EMBED_MODEL 换成自有端点，
# 接口形态一致，业务代码零改动（embedding_service.py 的 api 分支即为切换位）
KB_EMBED_MODE=off
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_REQUEST_TIMEOUT=60
EMBED_MAX_RETRIES=1

# --- SMTP（验证码邮件，auth 迁移后从 mock-server 接管）---
# 163 邮箱用授权码（不是登录密码），端口 465 走 SSL
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发送路由：real=真实 SMTP，mock=写到 logger 供团队测试从日志取码
# 团队联调 / 跑 scripts/test-accounts/ 时切到 mock，避免被 163 限流
SMTP_PROVIDER=real

# --- 速率限制（PRD 6.4 控成本）---
RATE_LIMIT_RECOMMENDATION_PER_DAY=5
RATE_LIMIT_SUMMARY_PER_DAY=1

# --- 板块三：群体匿名参照（pilot）---
# 最小群体规模 k（聚合写入与查询双重校验）
COMMUNITY_MIN_POOL=20
# 直方图桶计数下限 n（count<n 的桶并入相邻桶）
COMMUNITY_BUCKET_MIN=3
# 匿名参与 ID 的 HMAC 盐（务必为随机长字符串，不落库；轮换时保留最近 COMMUNITY_SALT_KEEP 个版本）
COMMUNITY_SALT=
COMMUNITY_SALT_KEEP=2
# 聚合查询限频：每用户每分钟次数（§4.8）
COMMUNITY_AGG_RATE_PER_MINUTE=5
# 「数据积累中」水印撤除门槛：连续达标周期数（§4.9）
COMMUNITY_DEMO_MIN_PERIODS=4
