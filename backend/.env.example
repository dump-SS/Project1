# 复制为 .env 后填入真实值，.env 已在仓库根 .gitignore 内
# 说明：pydantic-settings 会自动加载同目录下的 .env

# --- 服务 ---
APP_NAME=EpochX API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- 数据库 ---
# SQLite 文件路径；相对路径相对于 backend/ 目录
DATABASE_URL=sqlite:///./data.db

# --- 鉴权（占位，等队长通知再加 JWT 逻辑）---
# 现阶段用 mock bearer 即可，下个 PR 接入 JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AI 接入（占位，等 state_calculator.py / ai_suggestion.py 到位）---
# LLM 供应商抽象层，避免与单一厂商强耦合（PRD 6.4）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- 速率限制（PRD 6.4 控成本）---
RATE_LIMIT_RECOMMENDATION_PER_DAY=5
RATE_LIMIT_SUMMARY_PER_DAY=1
