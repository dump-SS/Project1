# 复制为 .env.local 后按需修改（.env.local 已被 .gitignore 忽略）

# 后端服务地址。留空时前端请求 /api/v1 会 404，页面自动保留占位数据。
# 后端起来之后填上，例如 http://localhost:8080
VITE_API_PROXY_TARGET=

# 接口基础路径，对应 openapi.yaml 的 servers.url
VITE_API_BASE_URL=/api/v1

# 开发期临时鉴权 token。openapi.yaml 约定 Authorization: Bearer <token>，
# MVP 不含登录接口，联调时直接填后端发的测试 token。
VITE_API_TOKEN=
