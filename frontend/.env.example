# 复制为 .env.local 后按需修改（.env.local 已被 .gitignore 忽略）
# 注意：Vite 从本目录（frontend/）读取 env 文件，放到仓库根目录不会生效。

# 接口代理目标。留空时 vite.config.ts 默认指向 http://localhost:4000，
# 也就是 ../mock-server（登录/注册等认证接口）。
# 业务后端（goals / learning-records / assessments）起来后改成它的地址即可。
VITE_API_PROXY_TARGET=

# 接口基础路径，对应 openapi.yaml 的 servers.url
VITE_API_BASE_URL=/api/v1

# 开发期临时鉴权 token。openapi.yaml 约定 Authorization: Bearer <token>。
# 认证服务已能签发会话，联调业务接口时把 token 填这里；
# 留空时个人数据页的接口会 401/404，页面自动退回占位数据并在卡片上标注。
VITE_API_TOKEN=
